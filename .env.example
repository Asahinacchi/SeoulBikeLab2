# Local object storage.
S3_ACCESS_KEY=s3admin
S3_SECRET_KEY=s3admin123
S3_ENDPOINT=localhost:8333

# Airflow metadata database and UI account.
POSTGRES_DB=airflow
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_FERNET_KEY=o2ulj8fvthAKpcBPL2dfAcy0e6HpYz16GDUYd2I0zAE=

# Airflow Connections are loaded declaratively by Docker Compose.
# Keep the SeaweedFS endpoint internal to the Docker network here.
AIRFLOW_CONN_S3_CONN={"conn_type":"aws","login":"s3admin","password":"s3admin123","extra":{"endpoint_url":"http://seaweedfs:8333","region_name":"us-east-1"}}
# Host must match the domain in source.url. For a manual GitHub fallback, use
# https://raw.githubusercontent.com and recreate Airflow services.
AIRFLOW_CONN_SOURCE_HTTP_CONN={"conn_type":"http","host":"https://archive.ics.uci.edu"}
